          "name": "List Findings",
          "request": {
            "name": "List Findings",
            "description": {
              "content": "Retrieves security findings for an application. Supports filtering by CWE, severity, scan type, CVSS score, policy violations, and annotation status.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "appsec",
                "v2",
                "applications",
                ":applicationGuid",
                "findings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "scan_type",
                  "value": "<string>",
                  "description": "Filter by scan type"
                },
                {
                  "disabled": false,
                  "key": "scan_type",
                  "value": "<string>",
                  "description": "Filter by scan type"
                },
                {
                  "disabled": false,
                  "key": "severity",
                  "value": "<integer>",
                  "description": "Filter by severity level (0=Informational, 1=Very Low, 2=Low, 3=Medium, 4=High, 5=Very High)"
                },
                {
                  "disabled": false,
                  "key": "severity_gte",
                  "value": "<integer>",
                  "description": "Filter findings with severity greater than or equal to this value"
                },
                {
                  "disabled": false,
                  "key": "cwe",
                  "value": "<string>",
                  "description": "Filter by CWE ID"
                },
                {
                  "disabled": false,
                  "key": "cvss_gte",
                  "value": "<number>",
                  "description": "Filter findings with CVSS score greater than or equal to this value"
                },
                {
                  "disabled": false,
                  "key": "violates_policy",
                  "value": "<boolean>",
                  "description": "Filter to only policy-violating findings"
                },
                {
                  "disabled": false,
                  "key": "include_annot",
                  "value": "false",
                  "description": "Include annotation data in response"
                },
                {
                  "disabled": false,
                  "key": "new",
                  "value": "<boolean>",
                  "description": "Filter to only new findings"
                },
                {
                  "disabled": false,
                  "key": "context",
                  "value": "<string>",
                  "description": "Sandbox GUID for sandbox-specific findings"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "0"
                },
                {
                  "disabled": false,
                  "key": "size",
                  "value": "20"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "applicationGuid",
                  "description": "(Required) Application unique identifier"
